# NodeAssistant model configuration
#
# Copy this file to .env and edit the values. Never commit .env.
# The app uses one OpenAI-compatible client. These three variables decide
# whether it talks to a local Ollama server or to OpenAI. No code change needed.
#
# Docker Compose (docker compose up) sets these for the app container itself
# and points at the Ollama service, so this file is for running the app
# directly on your machine with `python main.py`.

# --- Option A: local Ollama (default) -------------------------------------
# Ollama's OpenAI-compatible endpoint. The Compose stack publishes it on
# localhost, or run Ollama yourself: https://ollama.com
OPENAI_API_BASE=http://127.0.0.1:11434/v1
# Ollama ignores the key, but the client requires a value. Any string works.
OPENAI_API_KEY=ollama
# Model tag that is pulled into Ollama, e.g. `ollama pull llama3.2`.
OPENAI_MODEL=llama3.2

# --- Option B: OpenAI ------------------------------------------------------
# Comment out Option A and use these instead. Keep the real key out of git.
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-real-key
# OPENAI_MODEL=gpt-4o-mini
